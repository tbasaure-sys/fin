{
  "name": "meta-allocator-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "dotenv": "^17.3.1",
    "next": "^14.2.29",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "^0.0.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "perf:browser": "node scripts/performance-benchmark.mjs",
    "db:neon:apply": "node scripts/neon-apply.mjs",
    "db:holdings:bootstrap": "node scripts/bootstrap-neon-holdings.mjs",
    "db:runtime:seed": "node scripts/runtime-store-seed.mjs",
    "db:runtime:seed:full": "python3 scripts/runtime_store_seed.py",
    "snapshots:refresh": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-live-snapshots.ps1",
    "snapshots:refresh:dry": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/refresh-live-snapshots.ps1 -SkipGit",
    "snapshots:task:register": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/register-live-snapshot-task.ps1",
    "snapshots:sync": "node scripts/sync-live-snapshots.mjs",
    "g820:sync": "node scripts/sync-g820-snapshot.mjs",
    "g820:validate": "node scripts/validate-g820-bundle.mjs",
    "test:web": "node --conditions=react-server --test tests-node/*.test.mjs",
    "test:e2e": "playwright test --config tests-e2e/playwright.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1"
  }
}
