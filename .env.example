FMP_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT="MetaAlphaAllocator your_email@example.com"

DATABASE_URL=
BLS_PRIME_BREAKPOINT_FORK_SECRET=
BLS_PRIME_BACKEND_URL=
BLS_PRIME_BACKEND_RESEARCH_JOB_TIMEOUT_MS=60000
BLS_PRIME_AUTH_SECRET=
BLS_PRIME_PRIVACY_CONTACT=
BLS_PRIME_SESSION_COOKIE_NAME=bls_prime_session
BLS_PRIME_SESSION_DAYS=30
BLS_PRIME_E2E_AUTH_BYPASS=
BLS_PRIME_E2E_WORKSPACE_ID=workspace-e2e

# Macro Brain live source. Prefer URL in deployment; use path for local runs.
MACRO_BRAIN_SNAPSHOT_URL=https://blsprime.com/data/macro_brain_latest.json
MACRO_BRAIN_SNAPSHOT_PATH=
MOSAIC_SNAPSHOT_URL=https://blsprime.com/data/mosaic_embed.json
MOSAIC_SNAPSHOT_PATH=

# Equity research OS final LLM orchestrator.
# The deterministic engine and offline agents run before this. When enabled,
# exactly one final OpenAI-compatible chat completion call is attempted.
# auto = run the final orchestrator only when EQUITY_RESEARCH_LLM_API_KEY or OPENAI_API_KEY exists.
EQUITY_RESEARCH_LLM_ENABLED=auto
EQUITY_RESEARCH_LLM_API_KEY=
OPENAI_API_KEY=
EQUITY_RESEARCH_LLM_MODEL=gpt-4o-mini
EQUITY_RESEARCH_LLM_BASE_URL=https://api.openai.com/v1
EQUITY_RESEARCH_LLM_TIMEOUT_SECONDS=25
EQUITY_RESEARCH_LLM_MAX_TOKENS=900

# Open-source valuation explanation through Hugging Face Inference Providers.
# Numerical ranges remain deterministic; the model only classifies and explains.
HUGGINGFACE_VALUATION_ENABLED=auto
HUGGINGFACE_API_KEY=
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_VALUATION_MODEL=Qwen/Qwen2.5-7B-Instruct-1M:fastest
HUGGINGFACE_VALUATION_TIMEOUT_MS=12000
HUGGINGFACE_VALUATION_MAX_TOKENS=700
